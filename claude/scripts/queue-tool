#!/usr/bin/env python3
"""Deterministic parser for vault queue files (see SecondBrain CLAUDE.md, Task queues).

Subcommands:
  dump <project>            queue as JSON: items, duplicate IDs, unstamped lines, next free ^qN
  find <project> <qN|text>  one queue line as JSON, matched by ID or text fragment
  plans <project>           frontmatter backlinks (queue:/queue_item:) of every plan file
"""
import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

DEFAULT_VAULT = Path.home() / "obsidian" / "SecondBrain"
LANES = ["Next", "Ready", "Needs spec", "Blocked", "Someday", "Shipped"]
STATES = {" ": "open", "/": "in_progress", "x": "done", "-": "dropped"}
CHECKBOX = re.compile(r"^- \[([ /x-])\] (.*)$")
TRAILING_ID = re.compile(r"\s+\^q(\d+)\s*$")
ANY_ID = re.compile(r"\^q(\d+)")
TAGS = re.compile(r"#(claude|bug|feat|sec|ops)\b")
SIZE = re.compile(r"~(XS|S|M|L)\b")
ISSUE = re.compile(r"\(#(\d+)\)")
PLAN = re.compile(r"→plan:(\[\[[^\]]+\]\]|\S+)")
PR = re.compile(r"→pr:(\S+)")
QUEUES_REPO = Path(os.environ.get("VAULT_QUEUES", Path.home() / ".local/share/vault-queues"))


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def repo_queue_path(repo, project):
    p = Path(repo) / project / "Queue.md"
    if not p.is_file():
        die(f"no such file: {p}")
    return p


def git_run(repo, *args, check=True):
    return subprocess.run(["git", "-C", str(repo), *args],
                          capture_output=True, text=True, check=check)


def is_git_repo(repo):
    return (Path(repo) / ".git").exists()


def rebase_in_progress(repo):
    g = Path(repo) / ".git"
    return (g / "rebase-merge").exists() or (g / "rebase-apply").exists()


def pull_rebase(repo):
    if not is_git_repo(repo):
        return False
    r = git_run(repo, "pull", "--rebase", "--quiet", check=False)
    if r.returncode == 0:
        return True
    if rebase_in_progress(repo):
        git_run(repo, "rebase", "--abort", check=False)
        die(f"rebase conflict in {repo}: resolve manually, then retry")
    print(f"warning: remote unreachable, using local state ({repo})", file=sys.stderr)
    return False


def push_head(repo):
    return git_run(repo, "push", "--quiet", check=False).returncode == 0


def parse_item(state_char, body, lane, line_no, raw):
    item = {"line": line_no, "lane": lane, "state": STATES[state_char], "raw": raw}
    m = TRAILING_ID.search(body)
    item["id"] = f"q{m.group(1)}" if m else None
    if m:
        body = body[: m.start()]
    item["tags"] = TAGS.findall(body)
    m = SIZE.search(body)
    item["size"] = m.group(1) if m else None
    m = ISSUE.search(body)
    item["issue"] = int(m.group(1)) if m else None
    m = PLAN.search(body)
    item["plan"] = m.group(1) if m else None
    m = PR.search(body)
    item["pr"] = m.group(1) if m else None
    text = body
    for pat in (PR, PLAN, ISSUE, SIZE, TAGS):
        text = pat.sub("", text)
    item["text"] = re.sub(r"\s+", " ", text).strip()
    return item


def parse_queue_text(text, file="<memory>"):
    lane = None
    items = []
    ending_ids = []
    all_ids = []
    for line_no, raw in enumerate(text.splitlines(), 1):
        all_ids.extend(int(n) for n in ANY_ID.findall(raw))
        if raw.startswith("## "):
            title = raw[3:].strip()
            lane = title if title in LANES else None
            continue
        if lane is None or raw.startswith(">"):
            continue
        m = CHECKBOX.match(raw)
        if not m:
            continue
        item = parse_item(m.group(1), m.group(2), lane, line_no, raw)
        if item["id"]:
            ending_ids.append(item["id"])
        items.append(item)
    dup = sorted({i for i in ending_ids if ending_ids.count(i) > 1},
                 key=lambda i: int(i[1:]))
    return {
        "file": file,
        "items": items,
        "duplicates": dup,
        "unstamped": [i for i in items if not i["id"] and i["lane"] != "Shipped"],
        "next_id": f"q{max(all_ids, default=0) + 1}",
    }


def parse_queue(path):
    return parse_queue_text(path.read_text(), str(path))


STATE_CHARS = {"open": " ", "wip": "/", "done": "x", "dropped": "-"}


def find_item_index(lines, qid):
    pat = re.compile(rf"\s\^{re.escape(qid)}\s*$")
    hits = [i for i, l in enumerate(lines) if CHECKBOX.match(l) and pat.search(l)]
    if not hits:
        die(f"no queue line ends with ^{qid}")
    if len(hits) > 1:
        die(f"^{qid} is duplicated; restamp before mutating")
    return hits[0]


def insert_before_id(line, token):
    m = TRAILING_ID.search(line)
    if not m:
        return f"{line} {token}"
    return f"{line[:m.start()]} {token}{line[m.start():]}"


def joined(lines):
    return "\n".join(lines) + "\n"


def mutate_state(text, qid, state, reason=None):
    if state == "dropped" and not reason:
        die("dropped requires --reason")
    lines = text.splitlines()
    i = find_item_index(lines, qid)
    line = re.sub(r"^- \[[ /x-]\]", f"- [{STATE_CHARS[state]}]", lines[i])
    if state == "dropped":
        line = insert_before_id(line, f"(dropped: {reason})")
    lines[i] = line
    return joined(lines)


def section_insert_index(lines, lane):
    starts = [i for i, l in enumerate(lines) if l.strip() == f"## {lane}"]
    if not starts:
        die(f"no '## {lane}' section")
    end = len(lines)
    for j in range(starts[0] + 1, len(lines)):
        if lines[j].startswith("## "):
            end = j
            break
    while end > starts[0] + 1 and lines[end - 1].strip() == "":
        end -= 1
    return end


def mutate_lane(text, qid, lane):
    if lane not in LANES:
        die(f"unknown lane {lane!r}; one of {', '.join(LANES)}")
    lines = text.splitlines()
    i = find_item_index(lines, qid)
    line = lines.pop(i)
    lines.insert(section_insert_index(lines, lane), line)
    return joined(lines)


def set_marker(line, pat, token):
    if pat.search(line):
        return pat.sub(lambda m: token, line, count=1)
    return insert_before_id(line, token)


def mutate_mark(text, qid, plan=None, pr=None):
    if not plan and not pr:
        die("mark needs --plan or --pr")
    lines = text.splitlines()
    i = find_item_index(lines, qid)
    if plan:
        lines[i] = set_marker(lines[i], PLAN, f"→plan:{plan}")
    if pr:
        lines[i] = set_marker(lines[i], PR, f"→pr:{pr}")
    return joined(lines)


def next_free_id(text):
    return max((int(n) for n in ANY_ID.findall(text)), default=0) + 1


def mutate_add(text, lane, item_text):
    if ANY_ID.search(item_text):
        die("item text must not carry a ^qN; the tool stamps it")
    qid = f"q{next_free_id(text)}"
    lines = text.splitlines()
    lines.insert(section_insert_index(lines, lane), f"- [ ] {item_text} ^{qid}")
    return joined(lines), qid


def mutate_stamp(text):
    lines = text.splitlines()
    n = next_free_id(text)
    stamped = []
    for item in parse_queue_text(text)["unstamped"]:
        qid = f"q{n}"
        lines[item["line"] - 1] = f"{lines[item['line'] - 1].rstrip()} ^{qid}"
        stamped.append(qid)
        n += 1
    return joined(lines), stamped


VIEW_BANNER = [
    "",
    "> [!warning] Generated view (read-only)",
    "> Authority: the vault-queues repo. Edit with queue-tool or the /queue, /sync, /fable-plan, /implement-plan commands. Manual edits here are overwritten on the next queue write.",
    "",
]


def write_view(repo, vault, project):
    src = Path(repo) / project / "Queue.md"
    dst = Path(vault) / "projects" / project / "Queue.md"
    if not dst.parent.is_dir():
        print(f"warning: no vault project dir {dst.parent}, view skipped", file=sys.stderr)
        return
    lines = src.read_text().splitlines()
    end_fm = 0
    if lines and lines[0].strip() == "---":
        for j in range(1, len(lines)):
            if lines[j].strip() == "---":
                end_fm = j + 1
                break
    dst.write_text(joined(lines[:end_fm] + VIEW_BANNER + lines[end_fm:]))


def check_no_duplicates(text, context):
    dup = parse_queue_text(text)["duplicates"]
    if dup:
        die(f"duplicate IDs {', '.join(dup)} {context}; fix before writing")


def transact(repo, vault, project, message, mutate, require_remote=False):
    if not is_git_repo(repo):
        die(f"{repo} is not a git checkout; clone vault-queues there first")
    path = repo_queue_path(repo, project)
    for attempt in range(3):
        online = pull_rebase(repo)
        if require_remote and not online:
            die("offline: this operation mints IDs and needs the latest remote")
        before = path.read_text()
        check_no_duplicates(before, "already in the queue")
        result = mutate(before)
        after, extra = result if isinstance(result, tuple) else (result, None)
        if after == before:
            print("no change", file=sys.stderr)
            return None
        check_no_duplicates(after, "would be written")
        path.write_text(after)
        git_run(repo, "add", str(path))
        git_run(repo, "commit", "--quiet", "-m", message)
        if not online:
            print("committed locally, unpushed: run `queue-tool push` when online", file=sys.stderr)
            write_view(repo, vault, project)
            return extra
        if push_head(repo):
            write_view(repo, vault, project)
            return extra
        git_run(repo, "reset", "--hard", "HEAD~1", check=False)
    die("push kept failing after 3 attempts")


def norm_id(item):
    m = re.fullmatch(r"\^?q?(\d+)", item)
    if not m:
        die(f"not a queue ID: {item!r}")
    return f"q{m.group(1)}"


def cmd_state(args):
    transact(args.repo, args.vault, args.project,
             f"q: state {args.project} {args.item} {args.state}",
             lambda t: mutate_state(t, norm_id(args.item), args.state, args.reason))


def cmd_dump(args):
    pull_rebase(args.repo)
    print(json.dumps(parse_queue(repo_queue_path(args.repo, args.project)), indent=2))


def cmd_find(args):
    pull_rebase(args.repo)
    q = parse_queue(repo_queue_path(args.repo, args.project))
    m = re.fullmatch(r"\^?q?(\d+)", args.item)
    issue = re.fullmatch(r"#(\d+)", args.item)
    if m:
        matches = [i for i in q["items"] if i["id"] == f"q{m.group(1)}"]
    elif issue:
        matches = [i for i in q["items"] if i["issue"] == int(issue.group(1))]
    else:
        needle = args.item.lower()
        matches = [i for i in q["items"] if needle in i["text"].lower()]
    if not matches:
        die(f"no queue line matches {args.item!r}", 1)
    if len(matches) > 1:
        for i in matches:
            print(i["raw"], file=sys.stderr)
        die(f"{len(matches)} queue lines match {args.item!r}; be more specific", 1)
    print(json.dumps(matches[0], indent=2))


def cmd_plans(args):
    plans_dir = Path(args.vault) / "projects" / args.project / "plans"
    out = []
    for f in sorted(plans_dir.glob("*.md")) if plans_dir.is_dir() else []:
        entry = {"file": f.name, "queue": None, "queue_item": None, "queue_item_id": None}
        lines = f.read_text().splitlines()
        if lines and lines[0].strip() == "---":
            key = None
            for line in lines[1:]:
                if line.strip() == "---":
                    break
                m = re.match(r"(queue|queue_item):\s*(.*)$", line)
                if m:
                    key, value = m.group(1), m.group(2).strip().strip("\"'")
                    entry[key] = None if value in ("", ">-", ">", "|-", "|") else value
                elif key and line.startswith("  "):
                    entry[key] = ((entry[key] + " ") if entry[key] else "") + line.strip()
                else:
                    key = None
        if entry["queue_item"]:
            m = TRAILING_ID.search(entry["queue_item"])
            entry["queue_item_id"] = f"q{m.group(1)}" if m else None
        out.append(entry)
    print(json.dumps(out, indent=2))


def main():
    parser = argparse.ArgumentParser(prog="queue-tool", description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)

    def add(name, fn, *pos):
        p = sub.add_parser(name)
        for a in pos:
            p.add_argument(a)
        p.add_argument("--vault", default=DEFAULT_VAULT)
        p.add_argument("--repo", default=QUEUES_REPO)
        p.set_defaults(fn=fn)
        return p

    add("dump", cmd_dump, "project")
    add("find", cmd_find, "project", "item")
    add("plans", cmd_plans, "project")
    p = add("state", cmd_state, "project", "item")
    p.add_argument("state", choices=sorted(STATE_CHARS))
    p.add_argument("--reason")

    args = parser.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
